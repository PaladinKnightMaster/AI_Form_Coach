# ==============================================================================
# AI Form Coach — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
#
# ENVIRONMENT STRATEGY (single source of truth)
# ──────────────────────────────────────────────
# Next.js loads env files in this order (later wins):
#   .env  →  .env.local  →  .env.[mode]  →  .env.[mode].local
#
# We use:
#   .env.example     — Template (committed). Copy to .env.local for local dev.
#   .env.local       — Local dev overrides (gitignored). Has real Supabase keys.
#   .env.production  — Production defaults (gitignored). Overridden by Vercel env vars.
#
# Vercel env vars are the REAL source of truth for deployed environments.
# Set them in: Vercel Dashboard → Project → Settings → Environment Variables
# Scope each variable to the correct environment: Production, Preview, Development.
#
# ┌─────────────────────────────────┬───────────────────────────┬──────────────────────────────────┬──────────────────────────────────┐
# │ Variable                        │ Local (.env.local)        │ Vercel Preview                   │ Vercel Production                │
# ├─────────────────────────────────┼───────────────────────────┼──────────────────────────────────┼──────────────────────────────────┤
# │ NEXT_PUBLIC_SITE_URL            │ http://localhost:3000     │ (auto via NEXT_PUBLIC_VERCEL_URL)│ https://fitnessaiformcoach.vercel.app │
# │ NEXT_PUBLIC_BASE_URL            │ http://localhost:3000     │ (same as SITE_URL)               │ https://aiformcoach.com          │
# │ NEXT_PUBLIC_SUPABASE_URL        │ your project URL          │ same across all envs             │ same across all envs             │
# │ NEXT_PUBLIC_SUPABASE_ANON_KEY   │ your anon key             │ same across all envs             │ same across all envs             │
# │ SUPABASE_SERVICE_ROLE_KEY       │ your service role key     │ same across all envs             │ same across all envs             │
# │ NEXT_PUBLIC_UMAMI_WEBSITE_ID    │ (empty = disabled)        │ (empty = disabled)               │ 15f5f7e8-...                     │
# │ NEXT_PUBLIC_UMAMI_SRC           │ https://analytics...      │ https://analytics...             │ https://analytics...             │
# │ NEXT_PUBLIC_SENTRY_DSN          │ your DSN                  │ same across all envs             │ same across all envs             │
# └─────────────────────────────────┴───────────────────────────┴──────────────────────────────────┴──────────────────────────────────┘
#
# SUPABASE AUTH CONFIGURATION
# ───────────────────────────
# In Supabase Dashboard → Auth → URL Configuration:
#   Site URL:       https://fitnessaiformcoach.vercel.app
#   Redirect URLs:  https://fitnessaiformcoach.vercel.app/**
#                   https://*-paladinknightmasters-projects.vercel.app/**
#                   http://localhost:3000/**
#
# The app uses getSiteURL() (src/lib/auth/utils.ts) which falls back:
#   NEXT_PUBLIC_SITE_URL → NEXT_PUBLIC_VERCEL_URL → http://localhost:3000
# This means Preview deployments work automatically without setting SITE_URL.
# ==============================================================================

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Server-only, never expose to client

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000       # Auth redirect base URL (set per environment)
NEXT_PUBLIC_BASE_URL=http://localhost:3000        # Used for sitemap, robots.txt, OG images

# --- Analytics (Umami) ---
NEXT_PUBLIC_UMAMI_WEBSITE_ID=                     # Umami website ID (empty = analytics disabled)
NEXT_PUBLIC_UMAMI_SRC=https://analytics.umami.is/script.js

# --- Error Tracking (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=                           # Sentry DSN (empty = error reporting disabled)

# --- SEO ---
GOOGLE_SITE_VERIFICATION=                         # Google Search Console verification (optional)

# --- AI (Disabled in Beta 1 — required for Phase 2+ plan generation) ---
# GEMINI_API_KEY=                                 # Google Gemini API key

# --- Payments (Disabled in Beta 1 — required for Phase 2 monetization) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=             # Stripe publishable key (client-safe)
# STRIPE_SECRET_KEY=                              # Stripe secret key (server-only)
# STRIPE_PRICE_MONTHLY_ID=                        # Stripe price IDs
# STRIPE_PRICE_YEARLY_ID=
# STRIPE_PRICE_FOUNDER_ID=
# STRIPE_WEBHOOK_SECRET=                          # Stripe webhook signing secret

# --- Image APIs (optional) ---
# NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=
# NEXT_PUBLIC_PIXABAY_API_KEY=
