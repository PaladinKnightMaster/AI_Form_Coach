# ==============================================================================
# AI Form Coach — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ==============================================================================

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Server-only, never expose to client

# --- Site ---
NEXT_PUBLIC_BASE_URL=https://aiformcoach.com  # Used for sitemap, robots.txt, OG images

# --- Analytics (Umami) ---
NEXT_PUBLIC_UMAMI_WEBSITE_ID=  # Umami website ID (optional, analytics disabled if empty)
NEXT_PUBLIC_UMAMI_SRC=https://analytics.umami.is/script.js  # Umami script URL

# --- Error Tracking (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=  # Sentry DSN (optional, error reporting disabled if empty)

# --- SEO ---
GOOGLE_SITE_VERIFICATION=  # Google Search Console verification (optional)

# --- AI (Disabled in Beta 1 — required for Phase 2+ plan generation) ---
# GEMINI_API_KEY=  # Google Gemini API key for AI plan generation

# --- Payments (Disabled in Beta 1 — required for Phase 2 monetization) ---
# STRIPE_SECRET_KEY=  # Stripe secret key (server-only)
