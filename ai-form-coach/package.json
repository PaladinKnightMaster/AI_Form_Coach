{
  "name": "ai-form-coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next-with-baseline-env.mjs dev",
    "build": "node scripts/run-next-with-baseline-env.mjs build",
    "start": "node scripts/run-next-with-baseline-env.mjs start",
    "lint": "eslint middleware.ts src/app/page.tsx src/app/coach/page.tsx src/app/history/page.tsx src/app/session/[id]/page.tsx src/app/pricing/page.tsx src/app/privacy/page.tsx src/app/terms/page.tsx src/app/signin/page.tsx src/app/signup/page.tsx src/app/reset-password/page.tsx src/app/auth/callback/route.tsx src/app/auth/auth-code-error/page.tsx src/app/og-image/route.tsx src/app/opengraph-image.tsx src/app/twitter-image.tsx src/app/layout.tsx src/app/sitemap.ts src/app/robots.ts src/app/api/[...slug]/route.ts src/components/SiteHeader.tsx src/components/SiteFooter.tsx src/components/PoseOverlay.tsx src/components/AuthStatus.tsx src/components/AuthCard.tsx src/components/coach/CoachCameraChrome.tsx src/components/coach/CoachExperienceView.tsx src/lib/auth src/lib/mvp src/lib/history/publicHistory.ts src/lib/coach src/lib/pose/contracts.ts src/lib/pose/render.ts src/lib/pose/engine.ts src/lib/ai/providers.ts src/lib/supabase/client.ts src/__tests__/mvp",
    "test": "npm run test:mvp",
    "test:mvp": "vitest run src/__tests__/simple.test.ts src/__tests__/mvp",
    "test:automation": "vitest run src/__tests__/mvp",
    "test:e2e": "playwright test",
    "test:e2e:coach": "playwright test tests/e2e/coach.smoke.spec.ts",
    "test:e2e:coach:visual": "playwright test tests/e2e/coach.visual.spec.ts",
    "test:e2e:coach:visual:update": "playwright test tests/e2e/coach.visual.spec.ts --update-snapshots",
    "test:e2e:coach:iphone": "playwright test tests/e2e/coach.smoke.spec.ts --project=iphone-safari",
    "test:extended": "vitest run src/__tests__/integration src/__tests__/performance src/__tests__/pose src/__tests__/workflows src/lib",
    "test:pose-smoke": "vitest run src/__tests__/mvp/poseContracts.test.ts",
    "test:perf-smoke": "vitest run src/__tests__/performance/coach-performance-smoke.test.ts",
    "test:watch": "vitest",
    "test:workflows": "tsx scripts/run-tests.ts",
    "test:subscription": "tsx scripts/test-subscription-features.ts",
    "setup:subscription": "tsx scripts/setup-subscription-system.ts",
    "update:stripe-ids": "tsx scripts/update-stripe-price-ids.ts",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx scripts/seed.ts",
    "seed:nutrition": "tsx scripts/seed-nutrition.ts",
    "screenshots": "node scripts/screenshot-mobile.js",
    "demo": "echo 'Component demo available at http://localhost:3000/demo'",
    "test:e2e:coach:android": "playwright test tests/e2e/coach.smoke.spec.ts --project=android-chrome",
    "test:release": "npm run lint && npm run test && npm run test:perf-smoke && npm run build && npm run test:e2e:release",
    "test:e2e:coach:android:device": "node scripts/run-android-device-coach-smoke.mjs",
    "test:e2e:auth": "playwright test tests/e2e/auth.smoke.spec.ts",
    "test:e2e:release": "playwright test tests/e2e/auth.smoke.spec.ts tests/e2e/coach.smoke.spec.ts tests/e2e/coach.visual.spec.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@sentry/browser": "^8.36.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.56.1",
    "@zxing/library": "^0.21.3",
    "classnames": "^2.5.1",
    "dotenv": "^17.2.2",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^3.0.3",
    "next": "16.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^16.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.0.5",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "supabase": "^2.39.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.0.5"
  }
}
